{
  // Strict type checking for the Player Experience module (rules.md, C1).
  // The rest of the project still uses tsconfig.json, which is not strict.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/features/player-experience/**/*"],
  // Overrides the inherited list, which excludes the *.strict-check.ts proofs this config must compile.
  "exclude": ["node_modules"]
}
