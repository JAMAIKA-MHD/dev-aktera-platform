{
  "version": 1,
  "id": "comic-burst",
  "label": "Cartoon Pop",
  "description": "A comic-book burst: blue rays in a cream frame, red flames, a white cloud panel, yellow outlined buttons and a classic cartoon wheel.",
  "source": "style1-cartoon-style",
  "credits": "CREDITS.txt",
  "mode": "light",
  "palette": {
    "primary": "#FFE81F",
    "secondary": "#D62D2D",
    "accent": "#2F80D8",
    "surface": "#FFFFFF",
    "text": "#1B2A3A",
    "ink": "#1B2A3A"
  },
  "radius": "rounded",
  "font": "poppins",
  "fonts": {
    "display": "Luckiest Guy",
    "ui": "Fredoka",
    "stylesheet": "https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Luckiest+Guy&display=swap"
  },
  "tokens": {
    "radius": {
      "sm": "0.5rem",
      "md": "0.85rem",
      "lg": "1.1rem",
      "pill": "0.95rem"
    },
    "space": {
      "xs": "0.375rem",
      "sm": "0.625rem",
      "md": "1rem",
      "lg": "1.5rem"
    },
    "fontSize": {
      "display": "clamp(1.8rem, 8cqw, 3.25rem)",
      "title": "1.25",
      "body": "0.95rem",
      "label": "0.75rem"
    },
    "shadow": {
      "panel": "none",
      "card": "0.3rem 0.35rem 0 #1A62AB",
      "pop": "0.45rem 0.5rem 0 #1A62AB"
    }
  },
  "panel": {
    "bg": "#FFFFFF",
    "text": "@ink",
    "border": "@ink",
    "borderWidth": "0.25rem",
    "frame": null,
    "shape": {
      "src": "assets/frames/cloud.svg",
      "shadow": "clamp(0.5rem, 1.7vw, 1.6rem) clamp(0.5rem, 1.7vw, 1.6rem) 0 #1A62AB",
      "padInline": "clamp(2.25rem, 13.2vw, 13rem)",
      "padBlock": "clamp(2rem, 8svh, 6rem)",
      "stack": {
        "padInline": "clamp(1.75rem, 12.5vw, 3rem)",
        "src": "assets/frames/cloud-tall.svg",
        "screens": {
          "lose": "assets/frames/cloud-tall-dusk.svg"
        }
      },
      "columnMax": "29rem",
      "screens": {
        "lose": {
          "src": "assets/frames/cloud-dusk.svg",
          "shadow": "clamp(0.5rem, 1.7vw, 1.6rem) clamp(0.5rem, 1.7vw, 1.6rem) 0 #2C3750"
        }
      },
      "hiddenOn": ["play", "resolving", "revealing"]
    }
  },
  "card": {
    "bg": "#EAF4FE",
    "border": "@ink",
    "borderWidth": "0.2rem",
    "frame": null
  },
  "hud": {
    "bg": "#FFFFFF",
    "text": "@ink",
    "border": "@ink"
  },
  "button": {
    "primary": {
      "bg": "@primary",
      "text": "@ink",
      "border": "@ink",
      "borderWidth": "0.2rem",
      "shadow": "0.3rem 0.35rem 0 @ink",
      "shadowPressed": "0.08rem 0.1rem 0 @ink"
    },
    "secondary": {
      "bg": "#EAF4FE",
      "text": "@ink",
      "border": "@ink",
      "borderWidth": "0.2rem",
      "shadow": "0.3rem 0.35rem 0 #1A62AB",
      "shadowPressed": "0.08rem 0.1rem 0 #1A62AB"
    }
  },
  "field": {
    "bg": "#EAF4FE",
    "text": "@ink",
    "border": "@ink",
    "borderWidth": "0.2rem",
    "shadow": "0.3rem 0.35rem 0 @accent",
    "label": "#1E5FAE",
    "labelFont": "display"
  },
  "title": {
    "color": "@accent",
    "stroke": "@ink",
    "strokeWidth": "0.14em",
    "shadow": "0.05em 0.07em 0 @ink",
    "transform": "uppercase",
    "letterSpacing": "0.01em",
    "screens": {
      "win": "@primary",
      "lose": "@secondary"
    },
    "backdrop": {
      "src": "assets/frames/title-cloud.svg",
      "screens": ["play", "resolving", "revealing"]
    }
  },
