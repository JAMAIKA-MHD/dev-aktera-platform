{
  "version": 1,
  "id": "quiz-show",
  "label": "Quiz Show",
  "description": "A TV quiz show: spotlights over the stage, glowing LED walls, question-mark podiums and a marquee board lit with bulbs.",
  "source": "style4-quiz-style",
  "credits": null,
  "mode": "dark",
  "palette": {
    "primary": "#FFB020",
    "secondary": "#7A2FE0",
    "accent": "#3DDC84",
    "surface": "#050508",
    "text": "#FFFFFF",
    "ink": "#05061A"
  },
  "radius": "pill",
  "font": "poppins",
  "fonts": {
    "display": "Outfit",
    "ui": "Outfit",
    "stylesheet": "https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800;900&display=swap"
  },
  "tokens": {
    "radius": {
      "sm": "0.5rem",
      "md": "0.875rem",
      "lg": "1.25rem",
      "pill": "9999px"
    },
    "space": {
      "xs": "0.375rem",
      "sm": "0.625rem",
      "md": "1rem",
      "lg": "1.5rem"
    },
    "fontSize": {
      "display": "clamp(1.5rem, 7cqw, 2.5rem)",
      "title": "1.05",
      "body": "0.95rem",
      "label": "0.75rem"
    },
    "shadow": {
      "panel": "none",
      "card": "none",
      "pop": "0 0 2rem #FFB02059"
    }
  },
  "panel": {
    "bg": "#050508",
    "text": "@text",
    "border": "@primary",
    "borderWidth": "0",
    "frame": {
      "src": "assets/frames/marquee.svg",
      "slice": "100",
      "width": "clamp(1.75rem, 5.2vw, 4.75rem)",
      "outset": "0",
      "repeat": "round"
    },
    "shape": null,
    "frameScreens": {
      "win": "assets/frames/marquee-win.svg",
      "lose": "assets/frames/marquee-lose.svg"
    },
    "glow": "0 0 1.75rem #6E5AFF73",
    "room": {
      "inline": "clamp(2rem, 15.6vw, 13rem)",
      "block": "clamp(1.75rem, 8svh, 5.5rem)",
      "columnMax": "25rem"
    }
  },
  "card": {
    "bg": "#0E1030",
    "border": "#2E2F7A",
    "borderWidth": "0.125rem",
    "frame": null
  },
  "hud": {
    "bg": "#0A0B33D9",
    "text": "@text",
    "border": "#4630C4"
  },
  "button": {
    "primary": {
      "bg": "@primary",
      "text": "#9A3D06",
      "border": "#FF7A00",
      "borderWidth": "0.5rem",
      "shadow": "none",
      "shadowPressed": "none",
      "textShadow": "0 0.06em 0 #FFE9A8",
      "frame": {
        "src": "assets/buttons/button-gold.png",
        "slice": "56 70",
        "width": "calc(clamp(0.019rem, 0.013rem + 0.05vw, 0.026rem) * 56) calc(clamp(0.019rem, 0.013rem + 0.05vw, 0.026rem) * 70)",
        "outset": "0",
        "repeat": "stretch",
        "pixelated": false
      }
    },
    "secondary": {
      "bg": "#FF9A1F",
      "text": "#FFFFFF",
      "border": "#FF7A00",
      "borderWidth": "0.5rem",
      "shadow": "none",
      "shadowPressed": "none",
      "textShadow": "0 0.06em 0 #C2561A",
      "frame": {
        "src": "assets/buttons/button-gold-inset.png",
        "slice": "56 70",
        "width": "calc(clamp(0.019rem, 0.013rem + 0.05vw, 0.026rem) * 56) calc(clamp(0.019rem, 0.013rem + 0.05vw, 0.026rem) * 70)",
        "outset": "0",
        "repeat": "stretch",
        "pixelated": false
      }
    },
    "screens": {}
  },
  "field": {
    "bg": "#0E1030",
    "text": "#FFFFFF",
    "border": "#2E2F7A",
    "borderWidth": "0.125rem",
    "shadow": "none",
    "label": "#B8B2E6",
    "labelFont": "ui",
    "labelCase": "uppercase",
    "labelTracking": "0.16em"
  },
  "title": {
    "color": "#FFFFFF",
    "stroke": null,
    "strokeWidth": "0",
    "shadow": "0 0.05em 0 #00000080",
    "transform": "uppercase",
    "letterSpacing": "0",
    "weight": 900,
    "screens": {
      "win": "#FFC93A"
    },
    "shadows": {
      "win": "0 0.05em 0 #B86E00, 0 0 0.45em #FFB020CC",
      "lose": "0 0 0.45em #FF3B4ACC"
    },
    "backdrop": null
  },
  "stage": {
    "color": "#05061A",
    "overlay": "@ink",
    "overlayOpacity": 0,
    "backgrounds": {
      "default": "assets/backgrounds/bg-stage.svg",
      "games": {
        "quiz": "assets/backgrounds/bg-grid.svg"
      },
      "screens": {}
    },
    "decor": [
      {
        "src": "assets/decor/led-left.svg",
        "left": "0",
        "top": "16.667%",
        "width": "calc((50vw + 50vh) * 0.23)",
        "hideWhenLow": true
      },
      {
        "src": "assets/decor/led-right.svg",
        "right": "0",
        "top": "16.667%",
        "width": "calc((50vw + 50vh) * 0.23)",
        "hideWhenLow": true
      },
      {
        "src": "assets/decor/pedestal-left.svg",
        "left": "1.72%",
        "top": "46.944%",
        "width": "calc((50vw + 50vh) * 0.15)",
        "motion": "float",
        "hideWhenLow": true,
        "screens": [
          "welcome",
          "register",
          "duplicate",
          "closed",
          "error",
          "play",
          "resolving",
          "revealing",
          "win"
        ]
      },
      {
        "src": "assets/decor/pedestal-right.svg",
        "right": "1.72%",
        "top": "46.944%",
        "width": "calc((50vw + 50vh) * 0.15)",
        "motion": "float",
        "hideWhenLow": true,
        "screens": [
          "welcome",
          "register",
          "duplicate",
          "closed",
          "error",
          "play",
          "resolving",
          "revealing",
          "win"
        ]
      },
      {
        "src": "assets/decor/pedestal-left.svg",
        "left": "1.72%",
        "top": "46.944%",
        "width": "calc((50vw + 50vh) * 0.15)",
        "opacity": 0.45,
        "hideWhenLow": true,
        "screens": ["lose"]
      },
      {
        "src": "assets/decor/pedestal-right.svg",
        "right": "1.72%",
        "top": "46.944%",
        "width": "calc((50vw + 50vh) * 0.15)",
        "opacity": 0.45,
        "hideWhenLow": true,
        "screens": ["lose"]
      }
    ],
    "moods": true
  },
  "wheel": {
    "segments": ["#2A46D8", "#7A2FE0", "#E11D2E", "@primary"],
    "blank": "#0A0B33",
    "rim": "#1A1560",
    "rimInk": "@primary",
    "bulbs": "#FFD54A",
    "pointer": "@primary",
    "pointerInk": "@ink",
    "hub": "@primary",
    "hubText": "@ink"
  },
  "prizes": {
    "gift": "assets/prizes/gift.svg",
    "ticket": "assets/prizes/ticket.svg",
    "coin": "assets/prizes/coin.svg",
    "star": "assets/prizes/star.svg",
    "gem": "assets/prizes/gem.svg",
    "trophy": "assets/prizes/trophy.svg",
    "crown": "assets/prizes/crown.svg",
    "medal": "assets/prizes/medal.svg"
  },
  "characters": {
    "happy": "assets/characters/mascot-happy.svg",
    "sad": "assets/characters/mascot-sad.svg"
  },
  "sounds": {
    "click": "assets/sounds/click.mp3",
    "tick": "assets/sounds/tick.mp3",
    "win": "assets/sounds/win.mp3",
    "lose": "assets/sounds/lose.mp3",
    "reward": "assets/sounds/reward.mp3"
  },
  "layout": {
    "kind": "spotlight",
    "welcomeTeaser": false,
    "playCta": "round-below",
    "rewardCard": "flat",
    "characters": "hero"
  },
  "heroes": {
    "win": {
      "src": "assets/heroes/trophy.svg",
      "width": "clamp(3.5rem, min(7.5vw, 13svh), 6rem)"
    },
    "lose": {
      "src": "assets/heroes/cross.svg",
      "width": "clamp(3.25rem, min(9.5vw, 17svh), 7.5rem)"
    }
  },
  "copy": {
    "color": "#C9C3F2",
    "font": "ui",
    "transform": "none"
  }
}
