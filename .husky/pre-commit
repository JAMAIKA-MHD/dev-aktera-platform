# .husky/pre-commit
#
# Runs automatically every time you run `git commit`.
# Only checks the files you actually staged (git add), not the whole repo —
# this keeps it fast even as the codebase grows.
#!/usr/bin/env sh

echo "🔎 Running pre-commit checks..."

npx lint-staged

status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit checks failed."
    exit $status
fi

echo ""
echo "✅ Pre-commit checks passed."
