# .husky/pre-push
#
# Runs automatically every time you run `git push`.
# Runs the whole verify script (lint, typecheck, unit tests, build) and refuses the push
# when any of them fails.

#!/usr/bin/env sh

echo "🚀 Running pre-push verification..."

npm run verify

status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "❌ Push rejected."
    echo "Fix the issues above before pushing."
    exit $status
fi

echo ""
echo "✅ Verification successful."
echo "Push allowed."
