# .env.example
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials here.

# --- Supabase (client-side, safe to expose in browser bundle) ---
# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (server-side / CI only — NEVER prefix with VITE_) ---
# The VITE_ prefix tells Vite to inline the value into the shipped JS bundle.
# The service role key bypasses RLS entirely — if it ever gets a VITE_
# prefix, it ships to every visitor's browser. Keep this un-prefixed always.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- REGISTRATION CONTROL ---
# VITE_REGISTRATION_ENABLED: Controls frontend access to the registration page.
# Set to "true" to enable the /register route, "false" to disable it.
# This is a Vite-specific variable and is only available in the frontend code.
VITE_REGISTRATION_ENABLED="true"

# REGISTRATION_ENABLED: Controls backend logic for creating new organizations.
# Set to "true" to allow new account creation, "false" to block it at the API level.
# This variable must be set in your Supabase Edge Function settings for production.
REGISTRATION_ENABLED="true"


